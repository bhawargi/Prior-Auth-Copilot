# Copy to .env and fill in to run the agent on IBM watsonx.ai.
# Leave blank (or set AGENT_MODE=mock) to run the offline mock agent.
WATSONX_APIKEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-4-h-small
# WATSONX_API_VERSION=2024-05-31

# auto | watsonx | mock
AGENT_MODE=auto
# Seconds between mock-agent steps, so the live timeline is watchable.
MOCK_STEP_DELAY=0.7
PORT=8000
